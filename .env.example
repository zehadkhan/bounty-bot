# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# Leave empty first, send /start to your bot, it replies with your ID
TELEGRAM_CHAT_ID=

# Your HackerOne username (used in the apply checklist)
HACKERONE_USERNAME=zehadkhan

# How often to check (source data refreshes about every 30 min)
CHECK_INTERVAL_MINUTES=30

# Filters
ONLY_PAID=true
MIN_PAYOUT=0
PLATFORMS=hackerone,bugcrowd,intigriti,yeswehack,self-hosted
# Only alert for these words in name/domain/scope (comma separated). Empty = everything
KEYWORDS=

ALERT_SCOPE_CHANGES=true
ALERT_CLOSED=false
